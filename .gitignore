# =============================================================================
# .gitignore - UniCredit Portal (Next.js Frontend + ASP.NET Core Backend + MongoDB)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Operating System & Editor Files
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
*.stackdump
*~
*.swp
*.swo
*.bak
*.tmp
*.temp

# IDEs (Visual Studio, VS Code, JetBrains Rider / WebStorm)
.idea/
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs
*.DotSettings.user

# -----------------------------------------------------------------------------
# 2. Frontend (Node.js / Next.js / TypeScript)
# -----------------------------------------------------------------------------
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/sdks
!**/.yarn/versions

# Next.js & TypeScript build outputs
**/.next/
**/out/
**/dist/
**/build/
**/coverage/
**/.vercel/
**/.turbo/
*.tsbuildinfo
next-env.d.ts

# Environment variables & secret certificates
.env
.env.*
.env*.local
!.env.example
*.pem

# Package manager & runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*
lerna-debug.log*
**/*.log

# -----------------------------------------------------------------------------
# 3. Backend (C# / .NET / xUnit)
# -----------------------------------------------------------------------------
**/bin/
**/obj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET local environment settings, test results & packaging outputs
**/appsettings.Development.json
**/appsettings.Production.json
**/appsettings.Local.json
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
*.nupkg
*.snupkg
**/packages/
!**/packages/build/
*.PublishSettings
*.pubxml
*.azurePubxml


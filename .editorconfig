# EditorConfig helps maintain consistent coding styles for multiple developers working on the same project
root = true

[*]
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Web files (Frontend: Next.js, React, Tailwind, JSON, Markdown)
[*.{js,jsx,ts,tsx,json,css,scss,html,md}]
indent_size = 2

# C# and .NET files (Backend)
[*.{cs,csx}]
indent_size = 4

[*.csproj]
indent_size = 2

[*.sln]
indent_style = tab
end_of_line = crlf
